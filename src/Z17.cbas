Lbl A
ClrText
Mat Z[12,6→Z
{Z}
If Z=33
Then 
  "Fuyez, fuyez vite !"◢
  Return
IfEnd
ClrText
Locate 1,1,"~~~~~~ AUBERGE ~~~~~~"
Locate 1,2,"Bonjour etranger,"
Locate 1,3,"Que desires-tu ?"
Locate 3,5,"1.Sauvegarder"
Locate 3,6,"2.Me reposer (25$)"
Locate 3,7,"3.Sortir"
Do
  Getkey→θ
LpWhile θ≠72 And θ≠62 And θ≠52 And θ≠47
Z<10⇒θ<53⇒Prog "Z04"
θ<53⇒Return
If θ=62
Then 
  If 25>Mat Z[10,4
  Then 
    ClrText
    Green "Tu comptes me payer"
    Green "avec quoi ?"◢
    Goto A
  IfEnd
  Mat Z[10,4]-25→Mat Z[10,4
  ClrText
  Locate 2,1," ----- "
  Locate 2,2,"|ZZZZZ|"
  Locate 2,3," -v--- "
  Locate 4,4,"o"
  Locate 1,5,"°°°"
  Locate 10,3,"Vie :   /"
  Locate 8,5,"Magie :   /"
  Locate 8,4,"Force :   /"
  Locate 8,6,"Attak :   /"
  Locate 8,7,"Defns :   /"
  For 1→X To 5
    For 1→Y To 2
      Mat Z[X,2→Mat Z[X,1
      Locate 4Y+11,X+2,Mat Z[X,1
    Next
  Next
  0→U
  For 0→V To 8
    Isz U
    U=2⇒0→U
    For 3→W To 7
      Not U⇒Locate W,2,"Z"
      U⇒Locate W,2,"z"
      .1→X
      Prog "Z0"
    Next
  Next
IfEnd
If θ=72
Then 
  ClrText
  Locate 5,1," SAUVEGARDER "
  Locate 1,3,"Confirmer ?"
  Locate 1,7,"[EXE]→Oui  [EXIT]→Non"
  Do
    Getkey→θ
  LpWhile θ≠31 And θ≠47
  θ=47⇒Goto A
  ClrText
  Locate 7,4,"Saving..."
  {1,24}→Dim Mat Y
  For 1→K To 24
    3K-2→P
    Int ((P-1)/6)+1→L
    Int Mat Z[L,P-6L+6→A
    Int (P/6)+1→L
    Int Mat Z[L,P+1-6L+6→B
    Int ((P+1)/6)+1→L
    Int Mat Z[L,P+2-6L+6→C
    A*10^8+B*10^4+C→Mat Y[1,K
  Next
  ClrText
  Locate 7,4,"* Level *"
  Locate 7,5,"* Saved *"
  1→X
  Prog "Z0"
IfEnd
Goto A